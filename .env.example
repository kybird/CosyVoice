# CosyVoice Environment Configuration
# Copy this file to .env and adjust for your machine.
# .env is gitignored and never committed.

# ─── Project root (usually auto-detected, override only if needed) ──────────
# COSYVOICE_ROOT=C:\Project\TTSTextReader\CosyVoice

# ─── TTSTextViewer directory (sibling of CosyVoice, usually auto-detected) ─
# TTSTEXTVIEWER_DIR=C:\Project\TTSTextReader\TTSTextViewer

# ─── Reference WAV subdirectory within TTSTextViewer ────────────────────────
# Default: openvoice
# REF_WAV_SUBDIR=openvoice
